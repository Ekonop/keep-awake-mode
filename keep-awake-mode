#!/usr/bin/env bash
# keep-awake-mode — "Performance Keep-Awake" special mode for KDE Plasma 6
#
# ON : energy profile -> performance  +  block sleep & lid-sleep via systemd-inhibit
#      Display blanking is NOT inhibited (the panel may go blank), but the screen
#      does not lock: while ON, PowerDevil's LockBeforeTurnOffDisplay and the
#      KScreenLocker idle Autolock are forced off and reloaded live, so the desktop
#      keeps running and the hotspot keeps serving.
# OFF: remove the inhibitor, restore the energy profile and the exact lock
#      settings (AC/Battery/autolock) that were in effect before ON.
#
# The stock performance profile / PowerDevil settings are never modified.
# The state lives in a systemd user transient unit `keep-awake-inhibit`
# plus a small state file under XDG_STATE_HOME.
#
# Extra subcommands for the tray battery replacement (see README):
#   tray-enable   Replace the stock system-tray battery with the
#                 vansh.keepawake.battery plasmoid (Keep Awake slider stop)
#   tray-disable  Restore the stock battery applet
#   tray-status   Show which battery applet the tray hosts
#
# SPDX-License-Identifier: MIT
set -u

UNIT=keep-awake-inhibit
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/keep-awake-mode"
STATE_FILE="$STATE_DIR/state"
REASON="Keep-Awake mode (user $USER)"

usage() {
    cat <<'EOF'
usage: keep-awake-mode [on|off [profile]|toggle|status|state|tray-enable|tray-disable|tray-status]

  on                 Enable Keep-Awake: performance profile + block sleep/lid; the display may
                    blank, but the screen does NOT lock and the desktop keeps running
  off [profile]      Disable Keep-Awake, restore previous profile (or the given one)
  toggle             Toggle Keep-Awake mode
  status             Human-readable status
  state              Prints exactly ON or OFF (for widgets/scripts)
  tray-enable        Replace the stock system-tray battery with vansh.keepawake.battery
  tray-disable       Restore the stock system-tray battery applet
  tray-status        Show which battery applet the tray hosts
EOF
}

is_on() {
    [ "$(systemctl --user is-active "$UNIT" 2>/dev/null)" = "active" ]
}

start_mode() {
    if is_on; then
        echo "keep-awake mode already ON"
        return 0
    fi
    mkdir -p "$STATE_DIR"

    # remember the energy profile we are coming from so OFF can restore it
    prev="$(powerprofilesctl get 2>/dev/null || true)"
    [ -n "$prev" ] || prev="balanced"

    # start the inhibitor as a managed transient unit so we can stop it reliably.
    # Chain: systemd-inhibit (logind-level block on sleep+lid) wraps
    # kde-inhibit --power (KDE-level: no PowerDevil auto-suspend; does NOT block
    # display blanking, which would need --screenSaver) wraps `sleep infinity`,
    # the hold-open child. systemd-inhibit releases its locks the moment the child
    # exits, so the child must never end on its own (~='sleep infinity').
    #
    # Note: the unit is started BEFORE touching any lock config — if it fails,
    # nothing else has changed and the user's setup is left pristine.
    systemctl --user reset-failed "$UNIT" 2>/dev/null || true
    if ! systemd-run --user --unit="$UNIT" --collect \
        --description="Keep-Awake (performance)" \
        bash -c 'systemd-inhibit --what=sleep:handle-lid-switch --why="$0" --mode=block \
            kde-inhibit --power sleep infinity' "$REASON" \
        >/dev/null 2>&1; then
        echo "ERROR: could not start inhibitor (systemd-run failed)" >&2
        return 1
    fi
    # give logind a moment to register the inhibitor
    sleep 0.3
    if ! is_on; then
        echo "ERROR: inhibitor did not come up" >&2
        return 1
    fi

    # Suppress the screen lock (unit is up; failures below are non-fatal because
    # stop_mode restores from the state file written next). Two independent lock
    # paths can fire on idle in Plasma 6:
    #   * PowerDevil's DPMS action locks before blanking when
    #     LockBeforeTurnOffDisplay=true (per-profile; tablets default on)
    #   * KScreenLocker's [Daemon] Autolock locks on its own idle timer
    # Save the current values, force both off, then ask PowerDevil / the
    # screensaver to re-read their config live (refreshStatus -> loadProfile(true),
    # configure -> locker reload). The display may still blank: the DPMS action's
    # ChangeScreenSettings policy is NOT inhibited (no --screenSaver any more).
    lock_ac="$(kreadconfig6 --file powerdevilrc --group 'AC' --group Display --key LockBeforeTurnOffDisplay 2>/dev/null || true)"
    lock_batt="$(kreadconfig6 --file powerdevilrc --group 'Battery' --group Display --key LockBeforeTurnOffDisplay 2>/dev/null || true)"
    lock_low="$(kreadconfig6 --file powerdevilrc --group 'LowBattery' --group Display --key LockBeforeTurnOffDisplay 2>/dev/null || true)"
    autolock="$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Autolock 2>/dev/null || true)"
    [ -n "$lock_ac" ]   || lock_ac=UNSET
    [ -n "$lock_batt" ] || lock_batt=UNSET
    [ -n "$lock_low" ]  || lock_low=UNSET
    [ -n "$autolock" ]  || autolock=UNSET

    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file powerdevilrc --group 'AC' --group Display --key LockBeforeTurnOffDisplay --type bool false
        kwriteconfig6 --file powerdevilrc --group 'Battery' --group Display --key LockBeforeTurnOffDisplay --type bool false
        kwriteconfig6 --file powerdevilrc --group 'LowBattery' --group Display --key LockBeforeTurnOffDisplay --type bool false
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock --type bool false
    fi

    { printf 'prev=%s\nlock_ac=%s\nlock_batt=%s\nlock_low=%s\nautolock=%s\n' \
        "$prev" "$lock_ac" "$lock_batt" "$lock_low" "$autolock";
    } > "$STATE_FILE"

    # apply the lock-suppression live (PowerDevil reloads its profile settings,
    # the screen locker reloads its config)
    qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement \
        org.kde.Solid.PowerManagement.refreshStatus >/dev/null 2>&1 || true
    qdbus6 org.kde.screensaver /ScreenSaver org.kde.screensaver.configure >/dev/null 2>&1 || true

    powerprofilesctl set performance

    notify-send -i preferences-system-power-management \
        "Keep-Awake mode: ON" \
        "CPU: performance | display may blank but never locks | sleep/lid blocked" 2>/dev/null || true
    echo "keep-awake mode ON (unit: $UNIT, cpu: performance, restore: $prev, lock suppressed)"
}

stop_mode() {
    if ! is_on; then
        [ -n "${1:-}" ] && powerprofilesctl set "$1" 2>/dev/null || true
        echo "keep-awake mode already OFF"
        return 0
    fi
    prev="balanced"; lock_ac=UNSET; lock_batt=UNSET; lock_low=UNSET; autolock=UNSET
    if [ -f "$STATE_FILE" ]; then
        . "$STATE_FILE" # defines prev, lock_ac, lock_batt, lock_low, autolock
    fi
    systemctl --user stop "$UNIT" 2>/dev/null
    systemctl --user reset-failed "$UNIT" 2>/dev/null || true
    target="${1:-$prev}"
    powerprofilesctl set "$target" 2>/dev/null || true

    # restore the lock settings that were in effect before ON
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        if [ "$lock_ac" = UNSET ]; then
            kwriteconfig6 --file powerdevilrc --group 'AC' --group Display --key LockBeforeTurnOffDisplay --delete
        else
            kwriteconfig6 --file powerdevilrc --group 'AC' --group Display --key LockBeforeTurnOffDisplay --type bool "$lock_ac"
        fi
        if [ "$lock_batt" = UNSET ]; then
            kwriteconfig6 --file powerdevilrc --group 'Battery' --group Display --key LockBeforeTurnOffDisplay --delete
        else
            kwriteconfig6 --file powerdevilrc --group 'Battery' --group Display --key LockBeforeTurnOffDisplay --type bool "$lock_batt"
        fi
        if [ "$lock_low" = UNSET ]; then
            kwriteconfig6 --file powerdevilrc --group 'LowBattery' --group Display --key LockBeforeTurnOffDisplay --delete
        else
            kwriteconfig6 --file powerdevilrc --group 'LowBattery' --group Display --key LockBeforeTurnOffDisplay --type bool "$lock_low"
        fi
        if [ "$autolock" = UNSET ]; then
            kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock --delete
        else
            kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock --type bool "$autolock"
        fi
        # reload both daemons so the restored values take effect immediately
        qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement \
            org.kde.Solid.PowerManagement.refreshStatus >/dev/null 2>&1 || true
        qdbus6 org.kde.screensaver /ScreenSaver org.kde.screensaver.configure >/dev/null 2>&1 || true
    fi
    rm -f "$STATE_FILE"

    notify-send -i preferences-system-power-management \
        "Keep-Awake mode: OFF" \
        "Inhibitor removed | lock settings restored | energy profile: $target" 2>/dev/null || true
    echo "keep-awake mode OFF (energy profile restored to: $target)"
}

status() {
    if is_on; then
        prev="balanced"
        [ -f "$STATE_FILE" ] && . "$STATE_FILE"
        echo "ON  (energy profile: $(powerprofilesctl get 2>/dev/null || echo '?'), restore: $prev)"
        systemctl --user --no-pager status "$UNIT" 2>/dev/null | grep -E "Active|systemd-inhibit" | head -3 || true
    else
        echo "OFF (energy profile: $(powerprofilesctl get 2>/dev/null || echo '?'))"
    fi
}

# machine-readable for the tray widget: prints exactly ON or OFF
state() {
    if is_on; then
        echo "ON"
    else
        echo "OFF"
    fi
}

# ---------------------------------------------------------------------------
# Tray battery replacement
# ---------------------------------------------------------------------------

# Where the plasmoid package lives (repo checkout, user install, or system install)
find_plasmoid() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local candidates=(
        "$script_dir/../plasmoid/vansh.keepawake.battery"   # git checkout layout
        "$HOME/.local/share/plasma/plasmoids/vansh.keepawake.battery"
        "/usr/share/plasma/plasmoids/vansh.keepawake.battery"
    )
    local c
    for c in "${candidates[@]}"; do
        if [ -f "$c/metadata.json" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

appletsrc() {
    echo "${PLASMA_APPLETSRC:-$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc}"
}

# swap the tray battery between stock and our Keep-Awake applet.
# usage: swap_battery <old-id> <new-id>
swap_battery() {
    local file old_id new_id tmp
    file="$(appletsrc)"
    old_id="$1"
    new_id="$2"
    [ -f "$file" ] || { echo "no $file — nothing to do"; return 0; }
    tmp="$(mktemp)"

    # 1) every applet plugin= line (both standalone and tray-hosted items)
    # 2) the tray's item lists (extraItems / knownItems / shownItems)
    sed -e "s/^plugin=${old_id}$/plugin=${new_id}/" \
        -e "s/${old_id},/${new_id},/g"       \
        -e "s/=${old_id}$/=${new_id}/"       \
        "$file" > "$tmp"
    # keep a backup the first time we touch it
    if ! [ -f "$file.keepawake.bak" ]; then
        cp "$file" "$file.keepawake.bak"
    fi
    mv "$tmp" "$file"
    echo "appletsrc: ${old_id} -> ${new_id}"
}

tray_enable() {
    local plasmo
    plasmo="$(find_plasmoid)" || { echo "ERROR: vansh.keepawake.battery plasmoid not found" >&2; return 1; }

    # user-level install if we are a git checkout and not installed for this user yet
    if [[ "$plasmo" == *.local/share/plasma/plasmoids/* ]] || [[ "$plasmo" == /usr/share/plasma/plasmoids/* ]]; then
        : # already installed
    else
        local user_dst="$HOME/.local/share/plasma/plasmoids/vansh.keepawake.battery"
        mkdir -p "$(dirname "$user_dst")"
        rm -rf "$user_dst"
        cp -r "$plasmo" "$user_dst"
        plasmo="$user_dst"
        echo "installed plasmoid to $user_dst"
    fi

    swap_battery "org.kde.plasma.battery" "vansh.keepawake.battery"
    kbuildsycoca6 2>/dev/null || true

    # Write the exact script path into the tray applet's Configuration so the
    # QML toggle works even if the script is not on plasmashell's PATH.
    if command -v keep-awake-mode >/dev/null 2>&1; then
        local cmd
        cmd="$(command -v keep-awake-mode)"
        python3 - "$(appletsrc)" "$cmd" <<'PYEOF' || true
import sys
file, cmd = sys.argv[1], sys.argv[2]
lines = open(file).read().split("\n")
out = []
target_header = None
# find the last containment-hosted applet group whose plugin is ours
for i, line in enumerate(lines):
    out.append(line)
    if line.startswith("[Containments]") and i + 2 < len(lines) \
            and lines[i+1].startswith("immutability=") \
            and lines[i+2].startswith("plugin=vansh.keepawake.battery"):
        target_header = line
if target_header:
    cfg_header = target_header + "[Configuration]"
    gen_header = target_header + "[Configuration][General]"
    if gen_header in lines:
        # replace command= within the General block
        gi = lines.index(gen_header)
        end = gi
        for j in range(gi + 1, len(lines)):
            if lines[j].startswith("["):
                end = j
                break
        else:
            end = len(lines)
        block = lines[gi:end]
        if any(x.startswith("command=") for x in block):
            block = [x if not x.startswith("command=") else f"command={cmd}" for x in block]
        else:
            block.append(f"command={cmd}")
        lines[gi:end] = block
    elif cfg_header in lines:
        ci = lines.index(cfg_header)
        lines.insert(ci + 1, f"[General]")
        lines.insert(ci + 2, f"command={cmd}")
    else:
        ti = lines.index(target_header)
        lines.insert(ti + 1, "immutability=1")
        lines.insert(ti + 2, cfg_header)
        lines.insert(ti + 3, "[General]")
        lines.insert(ti + 4, f"command={cmd}")
    open(file, "w").write("\n".join(lines))
    print(f"wrote command={cmd} into tray applet config")
PYEOF
    fi

    # restart plasmashell so the tray reloads with our applet
    if pgrep -x plasmashell >/dev/null 2>&1; then
        plasmashell --replace >/dev/null 2>&1 &
        echo "plasmashell restarting…"
    fi
    echo "tray-enable done. The stock battery item is now vansh.keepawake.battery."
}

tray_disable() {
    swap_battery "vansh.keepawake.battery" "org.kde.plasma.battery"
    # drop the user-level plasmoid shipped by user installs
    if [ -d "$HOME/.local/share/plasma/plasmoids/vansh.keepawake.battery" ]; then
        rm -rf "$HOME/.local/share/plasma/plasmoids/vansh.keepawake.battery"
        echo "removed ~/.local/share/plasma/plasmoids/vansh.keepawake.battery"
    fi
    kbuildsycoca6 2>/dev/null || true
    if pgrep -x plasmashell >/dev/null 2>&1; then
        plasmashell --replace >/dev/null 2>&1 &
        echo "plasmashell restarting…"
    fi
    echo "tray-disable done. The stock battery applet is restored."
}

tray_status() {
    if grep -qE "^plugin=vansh\.keepawake\.battery" "$(appletsrc)" 2>/dev/null; then
        echo "tray battery: vansh.keepawake.battery (Keep-Awake)"
    else
        echo "tray battery: org.kde.plasma.battery (stock)"
    fi
}

case "${1:-toggle}" in
    on)          start_mode ;;
    off)         stop_mode "${2:-}" ;;
    toggle)      if is_on; then stop_mode; else start_mode; fi ;;
    status)      status ;;
    state)       state ;;
    tray-enable) tray_enable ;;
    tray-disable) tray_disable ;;
    tray-status) tray_status ;;
    -h|--help|help) usage ;;
    *)           echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac